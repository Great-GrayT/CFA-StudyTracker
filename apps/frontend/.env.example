# The backend origin. Only the server-side proxy reads this, never the browser,
# which is why it is not NEXT_PUBLIC_.
BACKEND_BASE_URL=https://cfa.polarislab.ir

# The public half of the VAPID key pair for push notifications. This value is
# genuinely public and safe to distribute; it proves the app's identity to the
# push service when subscribing.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
