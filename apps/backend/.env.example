# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cfa"

# JWT
# Signs session tokens AND the coach's unsubscribe tokens, so a guessable value
# lets anyone switch off anyone else's coaching. Use at least 32 random
# characters. Rotating it invalidates every session and every outstanding
# unsubscribe link.
JWT_SECRET="your-secret-key-here"
JWT_TTL_HOURS=24

# CRON
# Bearer secret for GET /api/cron/tick. If this is unset the route rejects
# every call, which means no progress snapshots and no coach emails, SILENTLY:
# a 401 is the correct response to a caller without the secret, so nothing
# logs an error. GET /api/health reports it as an error for that reason.
#
# The tick must be scheduled every 15 to 30 MINUTES, not nightly. The snapshot
# half is a once-a-day job, but the coach has three delivery slots in each
# candidate's own local time (06:30, 20:00, 22:30) and candidates are in
# different zones, so a nightly tick would miss almost all of them. Being late
# is safe: a slot stays due until it is actually sent, and the per-channel
# unique key makes a repeat attempt a no-op.
CRON_SECRET="your-cron-secret-here"

# CORS
CORS_ALLOW_ORIGINS="http://localhost:3000"

# OAuth: Google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# OAuth: GitHub
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# OAuth Redirect
# OAUTH_REDIRECT_BASE: this BACKEND's own origin - used to build the
# redirect_uri sent to Google/GitHub, where the /api/auth/oauth/[provider]/
# callback route lives.
OAUTH_REDIRECT_BASE="http://localhost:3000"
# FRONTEND_BASE_URL: the FRONTEND's origin (e.g. the Vercel app). Used for the
# post-login redirect to /auth/callback?token=... once the backend's own OAuth
# callback has finished, for the WebAuthn relying-party id, for password-reset
# links, and for every link in a coach email INCLUDING the unsubscribe link.
# Must NOT be the same as OAUTH_REDIRECT_BASE in a real deployment (backend and
# frontend are different origins).
#
# REQUIRED. The coach refuses to send without it rather than mailing dead
# links: an email whose unsubscribe link is broken gets reported as spam, and
# that costs the sending domain every other email the app sends.
FRONTEND_BASE_URL="http://localhost:5173"

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Web Push (VAPID), used for the coach's phone notifications. Generate a pair
# with: npx web-push generate-vapid-keys
#
# VAPID_SUBJECT must be a mailto: or https: URL, never a bare email address.
# A bare address makes web-push throw at module load, which takes down every
# route that imports it rather than merely disabling push. This is the single
# commonest VAPID mistake, so /api/health treats it as an error.
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:admin@example.com"

# Transactional mail, used by password reset AND by the daily study coach.
# Leave unset and the reset flow still responds normally (it must not reveal
# whether an address exists), but no mail is sent and a warning is logged.
# GET /api/health reports this as a warning rather than an error: the app runs
# without email, it simply does not coach.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Passkeys and two-step sign in need no extra configuration. The WebAuthn
# relying party id is derived from FRONTEND_BASE_URL's hostname, so that
# variable must be correct or every passkey ceremony fails.

# ---------------------------------------------------------------------------
# Checking a deployment
#
# GET /api/health returns 200 when the deployment is usable and 503 when
# something is set wrongly enough to break a user-visible feature, so a bad
# deploy fails its platform health check instead of sitting there serving
# traffic with no coach emails. It names the variables at fault and never
# echoes a value, since it is unauthenticated.
#
# It also catches values that are still the examples in this file, which a
# presence check cannot: a deploy that copied this file and changed only
# DATABASE_URL would otherwise look fully configured while signing tokens with
# a published secret.
#
# Schema changes ship as migrations (prisma/migrations). Deploy with
# `prisma migrate deploy`, never `prisma db push`: push is for local
# development and leaves no history, so a column added that way exists on the
# developer's machine and nowhere else.
