datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String?
  tokenVersion  Int            @default(0)
  createdAt     DateTime       @default(now())
  oauthAccounts OAuthAccount[]
  plans         StudyPlan[]
  packages      StudyPackage[]
  logs          StudyLogEntry[]
  mockExams     MockExam[]
  pushSubscriptions PushSubscription[]
  passwordResets    PasswordResetToken[]
  passkeys          Passkey[]
  recoveryCodes     RecoveryCode[]

  // Two-step sign in. The secret is only meaningful once totpEnabledAt is set:
  // setup writes the secret, and confirming a code is what turns it on. That
  // split stops a half-finished setup locking anyone out.
  totpSecret    String?
  totpEnabledAt DateTime?
}

// A pending password reset.
//
// The token is stored HASHED, never in plaintext: this table is the one place
// a database leak would otherwise hand an attacker working reset links for
// every pending request. The hash is SHA-256 rather than scrypt because the
// token is already 256 bits of CSPRNG output, so there is nothing to brute
// force and a slow KDF would only add latency.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  // Set when redeemed, so a token is single use and a replay is detectable
  // rather than silently succeeding.
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  @@index([userId])
  @@index([expiresAt])
}

// A registered passkey (WebAuthn credential).
//
// `counter` is the authenticator's signature counter. Verifying it never goes
// backwards is how a cloned authenticator is detected, which is the whole
// reason the field is persisted rather than ignored.
model Passkey {
  id             String   @id @default(cuid())
  userId         String
  credentialId   String   @unique
  publicKey      Bytes
  counter        BigInt   @default(0)
  transports     String[] @default([])
  deviceType     String?
  backedUp       Boolean  @default(false)
  // User-facing name, so someone with three passkeys can tell which is which.
  label          String?
  createdAt      DateTime @default(now())
  lastUsedAt     DateTime?
  user           User     @relation(fields: [userId], references: [id])
  @@index([userId])
}

// A short-lived WebAuthn challenge.
//
// Stored server side rather than round-tripped to the client: a challenge the
// client could choose is not a challenge, and replaying one would defeat the
// whole ceremony.
model WebAuthnChallenge {
  id        String   @id @default(cuid())
  // Null during a usernameless login, where the user is not known until the
  // authenticator answers.
  userId    String?
  challenge String   @unique
  kind      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}

// One recovery code for two-step sign in, stored hashed.
//
// These are the fallback when the authenticator app is gone, so they are as
// powerful as the second factor itself and get the same treatment as a
// password: never stored in a readable form.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
  @@index([userId])
}

model OAuthAccount {
  id                String @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  user              User   @relation(fields: [userId], references: [id])
  @@unique([provider, providerAccountId])
}

model Level {
  id       String           @id // "I" | "II" | "III"
  // Set by the seed script from the curriculum data it loads. The frontend
  // caches the tree in IndexedDB with a long max-age, and the curriculum is
  // reseeded yearly, so cached clients eventually hold LOS ids this database
  // no longer has. Echoing a version lets the client notice and refetch
  // instead of silently rendering blank rows.
  version  String           @default("unknown")
  topics   Topic[]
  plans    StudyPlan[]
  editions PackageEdition[]
}

model Topic {
  id            String    @id @default(cuid())
  levelId       String
  name          String
  order         Int
  examWeightMin Int
  examWeightMax Int
  level         Level     @relation(fields: [levelId], references: [id])
  readings      Reading[]
}

model Reading {
  id               String                @id @default(cuid())
  topicId          String
  name             String
  order            Int
  // Refs of readings that must precede this one (curriculum dependency chain)
  prereqRefs       String[]              @default([])
  // Which phase of a multi-phase curriculum this reading belongs to (e.g., foundations vs advanced)
  phaseBand        Int?
  // Relative importance within phase, lower is higher priority
  priorityRank     Int?
  topic            Topic                 @relation(fields: [topicId], references: [id])
  los              LOS[]
  packageUnitItems PackageUnitReading[]
}

model LOS {
  id               String              @id @default(cuid())
  readingId        String
  text             String
  order            Int
  reading          Reading             @relation(fields: [readingId], references: [id])
  logs             StudyLogEntry[]
  packageUnitItems PackageUnitLos[]
}

model StudyPackage {
  id       String           @id @default(cuid())
  userId   String?
  name     String
  slug     String?          @unique
  user     User?            @relation(fields: [userId], references: [id])
  logs     StudyLogEntry[]
  mockExams MockExam[]
  planPackages PlanPackage[]
  editions PackageEdition[]
}

model StudyPlan {
  id                 String             @id @default(cuid())
  // Local "HH:MM" per coach slot ({ prescription, nudge, debrief }); null
  // means the defaults in core/slots.ts.
  coachSchedule      Json?
  // The prior-work form exactly as last submitted, so it can be shown again.
  // The log rows derived from it are what the planner reads.
  priorWork          Json?
  userId             String
  levelId            String
  examDate           DateTime
  startDate          DateTime           @default(now())
  weeklyAvailability Json
  // Strategy for ordering tasks on each day (e.g., "curriculum", "weakness-first", "practice-dense")
  // Superseded as a candidate-facing choice by planMode below, but kept: it is
  // still what effort-return passes down to ordering.ts, and the existing
  // ordering tests and fixtures are written against it.
  orderingStrategy   String             @default("curriculum")
  // Which sequence the first pass follows. One of "effort-return" (the engine
  // as it was, topic cohesion before phase band), "curriculum-strict" (a fixed
  // sequence nothing reorders) or "curriculum-topic" (the default: identical
  // first pass, and only the review phase may depart from it, on evidence).
  planMode           String             @default("curriculum-topic")
  // When the review phase starts. One of "decay-triggered" (the default: the
  // first pass owns the calendar until a unit's mastery actually breaks its
  // bar), "after-coverage", "weekly-interleave" or "fixed-date".
  reviewPolicy       String             @default("decay-triggered")
  // Only read under the "fixed-date" policy, where the candidate names the
  // switchover themselves.
  reviewStartDate    DateTime?
  // Every constant the planner reads, as ONE json column rather than nineteen
  // typed ones. These are a single coherent settings object: always read
  // together, always written together, never queried individually, and adding
  // the twentieth constant should not cost a migration. core/tuning.ts is the
  // only thing that parses it, and it defaults every field, so a plan written
  // before this column existed needs no backfill.
  tuning             Json?
  isActive           Boolean            @default(true)
  // IANA timezone name (e.g., "Europe/London"). Defaults to UTC so an existing plan without an explicit
  // zone still behaves correctly without requiring a backfill migration.
  timeZone           String             @default("UTC")
  // Coaching preferences, one per delivery channel, because they are genuinely
  // different decisions: plenty of people want the full written briefing in
  // their inbox and only the evening prod on their phone, or the reverse. Both
  // take one of "all", "debrief-only", "off". Both default to "all".
  //
  // The two channels carry identical copy (one render feeds both), so these
  // control WHEN each channel speaks, never WHAT it says.
  emailCoach         String             @default("all")
  pushCoach          String             @default("all")
  // Where the candidate says they are, used to colour the coach's copy with local
  // weather and daylight. All four are nullable and optional: the candidate may
  // decline to say, and every downstream path treats absence as normal rather
  // than exceptional. City-level only, typed by the candidate rather than
  // inferred from their IP address, because a location we guessed is both less
  // accurate (VPNs) and considerably more unsettling than one they volunteered.
  city               String?
  countryCode        String?
  latitude           Float?
  longitude          Float?
  createdAt          DateTime           @default(now())
  user               User               @relation(fields: [userId], references: [id])
  level              Level              @relation(fields: [levelId], references: [id])
  logs               StudyLogEntry[]
  mockExams          MockExam[]
  snapshots          ProgressSnapshot[]
  holidays           PlanHoliday[]
  planPackages       PlanPackage[]
  tasks              PlanTask[]
  emailSends         EmailSend[]
}

// One task on a candidate's daily plan. A single task can span multiple readings
// (e.g., an ethics task covers seven modules). When a task is performed, it may
// generate multiple StudyLogEntry rows (one per LOS studied), so minutes live
// here on the task, not the log: one task fans out to many log entries, so a
// minute count on the log would be duplicated or divided, and calibration needs
// exactly one estimated-versus-actual pair per task.
model PlanTask {
  id                String        @id @default(cuid())
  planId            String
  date              DateTime
  // Position in this day's ordered task list (0-indexed within the day)
  order             Int
  // Closed vocabulary: content-notes, content-video, eocq, questions, answer-review, seminar, review, mock, mock-review
  kind              String
  // Optional reference to a provider resource (PackageResource)
  resourceId        String?
  // Reading IDs this task covers (plural because one Ethics task covers seven modules)
  readingIds        String[]      @default([])
  // Minutes budgeted for this task when it was generated. Stored as generated, never recomputed
  // on read, so a later recalibration cannot retroactively rewrite frozen history.
  estimatedMinutes  Int
  // Minutes actually spent on this task (null until completed). Observed measurement that pairs
  // with estimatedMinutes for calibration: one task generates one estimated-versus-actual pair.
  actualMinutes     Int?
  // Timestamp when the timer was started (if user clicked start before pausing/stopping)
  timerStartedAt    DateTime?
  // Current status: pending, in-progress, completed, skipped
  status            String        @default("pending")
  // If this task is a split-off from another task, the original task's ID
  splitOf           String?
  // Which piece in a multi-piece split (1-indexed), or null if not split
  splitIndex        Int?
  splitCount        Int?
  // Whether this task requires a confidence assessment (for practice questions)
  requiresConfidence Boolean      @default(false)
  // Target number of questions to attempt (for question-bank tasks)
  questionTarget    Int?
  // Start index of vignette within a resource (for case-study materials)
  vignetteFrom      Int?
  vignetteTo        Int?
  // Optional mode or variant (e.g., "timed", "untimed" for mock exams)
  mode              String?
  // Whether this task is frozen (immutable for history/audit purposes)
  frozen            Boolean       @default(false)
  // Reference to a StudyLogEntry (for tasks that generate exactly one log entry)
  logEntryId        String?
  // Reason this task was inserted programmatically (e.g., "retry-weak", "mock-review-inserted")
  insertedBecause   String?
  plan              StudyPlan     @relation(fields: [planId], references: [id])
  logs              StudyLogEntry[]
  @@index([planId, date])
  @@unique([planId, date, order])
}

model StudyLogEntry {
  id                String        @id @default(cuid())
  userId            String
  planId            String
  losId             String
  packageId         String?
  date              DateTime      @default(now())
  confidence        Int
  questionsAnswered Int           @default(0)
  questionsCorrect  Int           @default(0)
  // True for work the candidate declared at onboarding rather than logged as
  // they did it. Mastery treats these rows as real, because they are the best
  // evidence available about material studied before the plan existed, but the
  // flag keeps them distinguishable: a coach should not congratulate someone on
  // a session they only told us about.
  selfDeclared      Boolean       @default(false)
  // Set on a declared row when the candidate said they had READ the material,
  // as opposed to only having answered questions on it. The two are genuinely
  // different states to arrive in, and the planner treats them differently: the
  // first earns question-only days, the second earns reading-only days unless
  // the practice already proves the material is known.
  declaredRead      Boolean       @default(false)
  // Set on a declared row when the candidate said they had WATCHED the
  // module's videos. Credits the video only; the notes stay owed unless
  // declaredRead is also set.
  declaredWatched   Boolean       @default(false)
  // The plan task whose submission wrote this row, if any. Ticking a task and
  // logging a session are one act, so the task owns its rows: resubmitting
  // replaces them and undoing deletes them.
  taskId            String?
  task              PlanTask?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  note              String?
  user              User          @relation(fields: [userId], references: [id])
  plan              StudyPlan     @relation(fields: [planId], references: [id])
  los               LOS           @relation(fields: [losId], references: [id])
  package           StudyPackage? @relation(fields: [packageId], references: [id])
  @@index([planId, losId])
  @@index([taskId])
}

model MockExam {
  id            String        @id @default(cuid())
  userId        String
  planId        String
  date          DateTime
  scorePercent  Int
  packageId     String?
  note          String?
  user          User          @relation(fields: [userId], references: [id])
  plan          StudyPlan     @relation(fields: [planId], references: [id])
  package       StudyPackage? @relation(fields: [packageId], references: [id])
}

model ProgressSnapshot {
  id               String   @id @default(cuid())
  planId           String
  date             DateTime
  targetCumulative Int
  actualCumulative Int
  plan             StudyPlan @relation(fields: [planId], references: [id])
  @@unique([planId, date])
}

// One row per nightly tick. The tick already computes these counts and
// previously discarded them, which left the watchdogs screen with nothing to
// show and no way to tell "ran, nothing to do" from "never ran".
model CronRun {
  id              String   @id @default(cuid())
  startedAt       DateTime @default(now())
  finishedAt      DateTime?
  ok              Boolean  @default(false)
  plansProcessed  Int      @default(0)
  plansFailed     Int      @default(0)
  plansSkipped    Int      @default(0)
  // Null for the nightly global run; set when a user triggered a scoped run,
  // so one user's manual run is never mistaken for the scheduled sweep.
  triggeredByUserId String?
  error           String?
  @@index([startedAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model PlanHoliday {
  id        String    @id @default(cuid())
  planId    String
  startDate DateTime
  endDate   DateTime
  note      String?
  plan      StudyPlan @relation(fields: [planId], references: [id])
}

model PlanPackage {
  id        String       @id @default(cuid())
  planId    String
  packageId String
  roles     String[]
  plan      StudyPlan    @relation(fields: [planId], references: [id])
  package   StudyPackage @relation(fields: [packageId], references: [id])
  @@unique([planId, packageId])
}

// Third-party study provider catalogue: metadata for video lectures, question
// banks, and other content bundled by external providers (Kaplan, Mark Meldrum,
// etc). This model holds edition metadata like the provider's source version and
// the owner's link back to their provider account for refresh/sync operations.
model PackageEdition {
  id              String           @id @default(cuid())
  packageId       String
  levelId         String
  year            String
  ownerUserId     String?
  sourceUrl       String?
  snapshotDate    DateTime?
  note            String?
  package         StudyPackage     @relation(fields: [packageId], references: [id])
  level           Level            @relation(fields: [levelId], references: [id])
  units           PackageUnit[]
  resources       PackageResource[]
  @@unique([packageId, levelId, year])
  @@index([ownerUserId])
}

// One logical unit (lecture, chapter, etc) within a provider edition. Stores a
// ref as a deterministic string key rather than a composite key because all
// seven Quant modules share one notes PDF: a Drive id is not unique per
// resource, and a composite key containing a nullable column (unitId) enforces
// nothing in Postgres anyway.
model PackageUnit {
  id             String               @id @default(cuid())
  editionId      String
  ref            String
  order          Int
  providerLabel  String?
  title          String?
  topicLabel     String?
  sourceUrl      String?
  notesPageStart Int?
  notesPageCount Int?
  edition        PackageEdition       @relation(fields: [editionId], references: [id])
  resources      PackageResource[]
  readings       PackageUnitReading[]
  los            PackageUnitLos[]
  @@unique([editionId, ref])
  @@unique([editionId, order])
}

// One resource (video, PDF, question bank) within a unit or edition. The ref
// (e.g., provider's document id) is deterministic so assets can be detected as
// duplicates even when refreshed from the provider; a 32-bit int is enough for
// kilobytes (40 KB worksheets never overflow), and serialize as a normal
// number rather than throwing on JSON.stringify like BigInt does.
model PackageResource {
  id            String       @id @default(cuid())
  editionId     String
  unitId        String?
  ref           String
  kind          String
  title         String?
  externalId    String?
  sourceUrl     String?
  sizeKb        Int?
  durationSeconds Int?
  pageStart     Int?
  pageCount     Int?
  wordCount     Int?
  questionCount Int?
  vignetteCount Int?
  calcCount     Int?
  stmtCount     Int?
  exhibitCount  Int?
  sourceNote    String?
  edition       PackageEdition @relation(fields: [editionId], references: [id])
  unit          PackageUnit?   @relation(fields: [unitId], references: [id])
  @@unique([editionId, ref])
  @@index([unitId, kind])
  @@index([externalId])
}

// One LOS (Learning Outcome Statement) covered by a unit. This binding records
// whether the unit covers the full LOS or just part of it, so coverage
// calculations can account for partial overlap. The losId is nullable for
// edition-level assets like a formula sheet that may not map to any LOS.
model PackageUnitLos {
  id            String      @id @default(cuid())
  unitId        String
  sourceLabel   String
  losId         String?
  questionCount Int?
  retired       Boolean     @default(false)
  note          String?
  unit          PackageUnit @relation(fields: [unitId], references: [id])
  los           LOS?        @relation(fields: [losId], references: [id])
  @@unique([unitId, sourceLabel])
  @@index([losId])
}

// One Reading covered by a unit. This binding records how much of the reading
// the unit covers (full, partial, etc), so curriculum coverage can be tracked
// at the reading level and aggregated up.
model PackageUnitReading {
  id        String      @id @default(cuid())
  unitId    String
  readingId String
  coverage  String      @default("full")
  note      String?
  unit      PackageUnit @relation(fields: [unitId], references: [id])
  reading   Reading     @relation(fields: [readingId], references: [id])
  @@unique([unitId, readingId])
  @@index([readingId])
}

// One email send record for idempotent email scheduling. Tracks which email slots have been sent
// to a plan on a given date in the candidate's own calendar.
// One delivery of one coach message on one channel.
//
// Named EmailSend before push existed. Kept rather than renamed because the
// table is already in applied migration history and a rename buys nothing but
// risk; read it as "coach send". The `channel` column is what distinguishes a
// row now, and the unique key includes it so each channel claims its own slot
// atomically.
model EmailSend {
  id              String   @id @default(cuid())
  planId          String
  // The candidate's local calendar date as YYYY-MM-DD, NOT a DateTime. Storing as a DateTime would
  // invite a timezone conversion somewhere downstream and reintroduce the exact bug the whole timezone
  // design exists to prevent. A date is a label in their calendar, not an instant.
  localDate       String
  // Email slot sent: one of "prescription", "nudge", "debrief"
  slot            String
  // Delivery channel: one of "email", "push". Part of the unique key, so a
  // candidate with email off and push on still gets exactly one notification
  // per slot per day, guarded by the database rather than by application logic
  // that could itself race.
  channel         String   @default("email")
  // Which dialogue state was chosen (a DialogueKey, e.g. "P_CRISIS"). Nullable
  // because rows predate the column. Recorded for two reasons: without it there
  // is no record anywhere of what a candidate was actually told, and the
  // once-only sign-off after the exam needs to know whether it has already gone
  // out. The unique key is per local DATE, so without this check the P_PAST
  // copy, which promises no further emails, would be sent every morning forever.
  dialogueKey     String?
  sentAt          DateTime?
  failedAttempts  Int      @default(0)
  lastError       String?
  createdAt       DateTime @default(now())
  plan            StudyPlan @relation(fields: [planId], references: [id])
  // Central guard against duplicate sends: prevents the same slot reaching the
  // same candidate twice on the same channel on one day, even when the cron
  // re-runs, retries overlap, or the scheduler crashes mid-flight. Channel is
  // in the key because email and push are independent deliveries: silencing one
  // must not silence the other, and sending one must not suppress the other.
  @@unique([planId, localDate, slot, channel])
  @@index([planId, localDate])
}

// One day's weather for one place, cached so the coach makes at most a single
// forecast call per city per day no matter how many candidates live there.
//
// Keyed by a rounded coordinate grid rather than by plan, so two candidates in
// the same city share one reading. Rounding to two decimals is roughly a
// kilometre, which is far finer than the buckets in `core/weather.ts` need.
model WeatherReading {
  id            String   @id @default(cuid())
  // Rounded "lat,lon", built by roundToGrid in lib/FUNC-weather.ts.
  gridKey       String
  // The candidate's own calendar day as a plain string, matching EmailSend.
  // A date here would invite a timezone conversion and reintroduce the exact
  // bug the whole timezone layer exists to prevent.
  localDate     String
  weatherCode   Int
  tempMaxC      Float
  daylightHours Float
  fetchedAt     DateTime @default(now())

  @@unique([gridKey, localDate])
}
