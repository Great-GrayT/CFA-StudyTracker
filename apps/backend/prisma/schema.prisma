datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String?
  tokenVersion  Int            @default(0)
  createdAt     DateTime       @default(now())
  oauthAccounts OAuthAccount[]
  plans         StudyPlan[]
  packages      StudyPackage[]
  logs          StudyLogEntry[]
  mockExams     MockExam[]
  pushSubscriptions PushSubscription[]
  passwordResets    PasswordResetToken[]
}

// A pending password reset.
//
// The token is stored HASHED, never in plaintext: this table is the one place
// a database leak would otherwise hand an attacker working reset links for
// every pending request. The hash is SHA-256 rather than scrypt because the
// token is already 256 bits of CSPRNG output, so there is nothing to brute
// force and a slow KDF would only add latency.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  // Set when redeemed, so a token is single use and a replay is detectable
  // rather than silently succeeding.
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  @@index([userId])
  @@index([expiresAt])
}

model OAuthAccount {
  id                String @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  user              User   @relation(fields: [userId], references: [id])
  @@unique([provider, providerAccountId])
}

model Level {
  id     String  @id // "I" | "II" | "III"
  // Set by the seed script from the curriculum data it loads. The frontend
  // caches the tree in IndexedDB with a long max-age, and the curriculum is
  // reseeded yearly, so cached clients eventually hold LOS ids this database
  // no longer has. Echoing a version lets the client notice and refetch
  // instead of silently rendering blank rows.
  version String  @default("unknown")
  topics Topic[]
  plans  StudyPlan[]
}

model Topic {
  id            String    @id @default(cuid())
  levelId       String
  name          String
  order         Int
  examWeightMin Int
  examWeightMax Int
  level         Level     @relation(fields: [levelId], references: [id])
  readings      Reading[]
}

model Reading {
  id      String @id @default(cuid())
  topicId String
  name    String
  order   Int
  topic   Topic  @relation(fields: [topicId], references: [id])
  los     LOS[]
}

model LOS {
  id        String          @id @default(cuid())
  readingId String
  text      String
  order     Int
  reading   Reading         @relation(fields: [readingId], references: [id])
  logs      StudyLogEntry[]
}

model StudyPackage {
  id        String          @id @default(cuid())
  userId    String?
  name      String
  user      User?           @relation(fields: [userId], references: [id])
  logs      StudyLogEntry[]
  mockExams MockExam[]
  planPackages PlanPackage[]
}

model StudyPlan {
  id                 String             @id @default(cuid())
  userId             String
  levelId            String
  examDate           DateTime
  startDate          DateTime           @default(now())
  weeklyAvailability Json
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  user               User               @relation(fields: [userId], references: [id])
  level              Level              @relation(fields: [levelId], references: [id])
  logs               StudyLogEntry[]
  mockExams          MockExam[]
  snapshots          ProgressSnapshot[]
  holidays           PlanHoliday[]
  planPackages       PlanPackage[]
}

model StudyLogEntry {
  id                String        @id @default(cuid())
  userId            String
  planId            String
  losId             String
  packageId         String?
  date              DateTime      @default(now())
  confidence        Int
  questionsAnswered Int           @default(0)
  questionsCorrect  Int           @default(0)
  note              String?
  user              User          @relation(fields: [userId], references: [id])
  plan              StudyPlan     @relation(fields: [planId], references: [id])
  los               LOS           @relation(fields: [losId], references: [id])
  package           StudyPackage? @relation(fields: [packageId], references: [id])
  @@index([planId, losId])
}

model MockExam {
  id            String        @id @default(cuid())
  userId        String
  planId        String
  date          DateTime
  scorePercent  Int
  packageId     String?
  note          String?
  user          User          @relation(fields: [userId], references: [id])
  plan          StudyPlan     @relation(fields: [planId], references: [id])
  package       StudyPackage? @relation(fields: [packageId], references: [id])
}

model ProgressSnapshot {
  id               String   @id @default(cuid())
  planId           String
  date             DateTime
  targetCumulative Int
  actualCumulative Int
  plan             StudyPlan @relation(fields: [planId], references: [id])
  @@unique([planId, date])
}

// One row per nightly tick. The tick already computes these counts and
// previously discarded them, which left the watchdogs screen with nothing to
// show and no way to tell "ran, nothing to do" from "never ran".
model CronRun {
  id              String   @id @default(cuid())
  startedAt       DateTime @default(now())
  finishedAt      DateTime?
  ok              Boolean  @default(false)
  plansProcessed  Int      @default(0)
  plansFailed     Int      @default(0)
  plansSkipped    Int      @default(0)
  // Null for the nightly global run; set when a user triggered a scoped run,
  // so one user's manual run is never mistaken for the scheduled sweep.
  triggeredByUserId String?
  error           String?
  @@index([startedAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model PlanHoliday {
  id        String    @id @default(cuid())
  planId    String
  startDate DateTime
  endDate   DateTime
  note      String?
  plan      StudyPlan @relation(fields: [planId], references: [id])
}

model PlanPackage {
  id        String       @id @default(cuid())
  planId    String
  packageId String
  roles     String[]
  plan      StudyPlan    @relation(fields: [planId], references: [id])
  package   StudyPackage @relation(fields: [packageId], references: [id])
  @@unique([planId, packageId])
}
