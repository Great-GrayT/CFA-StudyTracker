{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@prisma/client": "^6.1.0",
    "zod": "^3.24.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "typescript": "^5.7.2",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/web-push": "latest",
    "vitest": "latest",
    "tsx": "latest"
  },
  "engines": {
    "node": ">= 20"
  },
  "packageManager": "pnpm@11.9.0"
}
