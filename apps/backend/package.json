    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@simplewebauthn/server": "^14.1.0",
    "next": "^15.1.3",
