    "otplib": "^13.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "prisma": "^6.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">= 20"
